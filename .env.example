APP_NAME=shared-core
ENV=development
DEBUG=true

# Database Connection (pgvector on port 5432)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres

# Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Redis Connection (Redis on port 6379)
REDIS_URL=redis://localhost:6379/0

# Observability
LOG_LEVEL=INFO

# API Keys (Optional defaults)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
